{
  "name": "dsh-plugin-finder",
  "version": "0.2.0-preview.1",
  "description": "Discover task-fit plugins from live DeepSeek Harness ecosystem sources, understand author documentation, and continue in a native conversation",
  "author": "牛村木木山",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13",
    "dsh": "0.2.0-rc.2 || 0.2.1-rc.2"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./dist/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "src/",
    "catalog/index.mjs",
    "dist/client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "docs/install.md",
    "docs/verification.md",
    "docs/first-use-case.md",
    "docs/experiment.md"
  ],
  "scripts": {
    "test": "node --test --test-concurrency=1 test/*.test.mjs",
    "build": "node scripts/build.mjs",
    "catalog:refresh": "node scripts/refresh-catalog.mjs"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "react": "19.2.0"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "dependencies": {
    "zod": "4.6.5"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-storage-domain": "0.2.0-rc.2 || 0.2.1-rc.2",
    "@deepseek-ai/dsh-app-boot": "0.2.0-rc.2 || 0.2.1-rc.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/piggy00544/dsh-plugin-finder.git"
  },
  "homepage": "https://github.com/piggy00544/dsh-plugin-finder",
  "bugs": {
    "url": "https://github.com/piggy00544/dsh-plugin-finder/issues"
  }
}
